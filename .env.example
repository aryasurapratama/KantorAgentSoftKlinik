# Optional key for an OpenAI-compatible provider. Ollama does not need a key.
# AI_API_KEY=
# Optional GitHub OAuth app (create at GitHub Settings → Developer settings → OAuth Apps).
# Keep the client secret only in this local server environment; never commit it.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# Optional Telegram Bot API base URL (leave default for production; override for local tests).
# TELEGRAM_API_BASE_URL=https://api.telegram.org
