PORT=4318
# Optional PostgreSQL persistence. Leave DATABASE_URL empty to use data/*.json.
# DATABASE_URL=postgresql://kantor_app:password@127.0.0.1:5432/kantor_agent
# Optional key for an OpenAI-compatible provider. Ollama does not need a key.
# AI_API_KEY=
# API keys are bound to one provider origin; Ollama never receives a key.
# AI_API_KEY_ORIGIN=https://api.openai.com
# Additional HTTPS hosts for OpenAI-compatible APIs, comma separated.
# AI_ALLOWED_HOSTS=
# Local OpenAI-compatible gateways require an explicit opt-in.
# AI_ALLOW_LOCAL_COMPATIBLE=1
# Ollama keeps a verified model warm between requests; lower this on memory-constrained devices.
# OLLAMA_KEEP_ALIVE=5m
# Maximum time allowed for one model response. Default: 120 seconds; hard cap: 300 seconds.
# AI_PROVIDER_TIMEOUT_MS=300000
# Max in-process model calls. Default: 1; 9Router defaults to 2; hard cap: 2 for 16 GB RAM laptops.
# AI_MAX_CONCURRENCY=2
# Retry transient network/408/429 provider failures. Default: 1; hard cap: 2.
# AI_MAX_RETRIES=1
# Process RSS warning limit for resource telemetry. Default: 12288 MB.
# HARMES_MEMORY_LIMIT_MB=12288
# The dedicated 9Router provider accepts only loopback /v1 endpoints;
# it does not need AI_ALLOW_LOCAL_COMPATIBLE. Default: http://127.0.0.1:20128/v1
# Optional bearer token for local scripts. Browser uses an HttpOnly session.
# API_TOKEN=
# Reverse proxy host/origin allowlists for HTTPS deployments, comma separated.
# API_ALLOWED_HOSTS=app.example.com
# API_ALLOWED_ORIGINS=https://app.example.com
# Optional GitHub OAuth app (create at GitHub Settings → Developer settings → OAuth Apps).
# Keep the client secret only in this local server environment; never commit it.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# Optional GitHub App (preferred). Keep the private key only in this local server environment.
# GITHUB_APP_ID=
# GITHUB_APP_SLUG=
# GITHUB_APP_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# Optional Telegram Bot API base URL (leave default for production; override for local tests).
# TELEGRAM_API_BASE_URL=https://api.telegram.org
